# Core
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=meta-bru
PORT=5001

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-hex-secret
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Exact frontend origins allowed by CORS (comma separated, no trailing slash)
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Where the backend sends the browser to finish OAuth. Defaults to the first CLIENT_URL.
FRONTEND_URL=http://localhost:3000

# Meta app (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5001/api/connections/meta/callback
META_GRAPH_VERSION=v26.0
# Optional override. Defaults to:
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# Cloudinary (media hosting; Instagram requires a public image URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (caption drafts and Imagen image generation)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# One-time admin bootstrap (only needed for the seed:admin script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Scheduling
APP_DEFAULT_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
# If the server was down, skip slots older than this instead of posting late.
SCHEDULER_GRACE_MINUTES=180
