# Core
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=meta-bru
PORT=5001

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-hex-secret
# Encrypts Page tokens and each user's integration credentials.
# Generate with: openssl rand -hex 32
# Keep this value stable; changing it makes stored secrets unreadable.
TOKEN_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Exact frontend origins allowed by CORS (comma separated, no trailing slash)
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Where the backend sends the browser to finish OAuth. Defaults to the first CLIENT_URL.
FRONTEND_URL=http://localhost:3000

# Meta OAuth callback (deployment-level)
# Each user enters their own Meta App ID and App Secret under Profile.
# Their Meta app must whitelist this exact callback URL.
META_REDIRECT_URI=http://localhost:5001/api/connections/meta/callback
META_GRAPH_VERSION=v26.0
# Optional override. Defaults to:
# META_SCOPES=pages_show_list,pages_read_engagement,read_insights,pages_manage_posts,business_management,instagram_basic,instagram_content_publish,instagram_manage_insights

# Gemini model selection (deployment-level)
# Each user enters their own Gemini API key under Profile.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudinary, Meta app, and Gemini credentials are not configured here. Each
# user adds their own Meta app credentials, Cloudinary cloud name/API key/API
# secret, and Gemini API key under Profile after signing in. They are encrypted
# at rest.

# One-time admin bootstrap (only needed for the seed:admin script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Scheduling
APP_DEFAULT_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
# If the server was down, skip slots older than this instead of posting late.
SCHEDULER_GRACE_MINUTES=180
